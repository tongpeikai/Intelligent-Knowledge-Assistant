# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际配置
# ============================================================

# ---------- LLM 配置 ----------
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
DEEPSEEK_API_KEY=replace-with-your-key

# ---------- Local API security (optional) ----------
# Set a long random value to require: Authorization: Bearer <token>
# IKA_API_TOKEN=replace-with-a-random-local-token
API_RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=10485760

# Offline English-to-Chinese technical term expansion for RAG
ENABLE_BILINGUAL_QUERY_EXPANSION=true

# ---------- 嵌入模型配置（可选）----------
# 嵌入模型路径：
# - 留空或不设置：使用默认相对路径 models/bge-small-zh-v1.5
# - 绝对路径：指向你机器上已有的模型目录（不要提交个人路径）
# - HuggingFace 模型名：如 BAAI/bge-small-zh-v1.5（需联网下载）
# EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
